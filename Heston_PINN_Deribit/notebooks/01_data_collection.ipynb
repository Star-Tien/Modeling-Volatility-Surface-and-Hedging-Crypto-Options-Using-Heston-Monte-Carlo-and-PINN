 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 1: Thu thập dữ liệu từ Deribit API\n",
    "\n",
    "Notebook này kết nối với Deribit API (Testnet) để tải thông tin các hợp đồng quyền chọn BTC đang hoạt động, truy vấn sổ lệnh để lấy giá thị trường thực tế (Best Bid/Ask) và tính toán thời gian đáo hạn $T$."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import pandas as pd\n",
    "import time\n",
    "from datetime import datetime\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# Thêm thư mục cha vào sys.path để import được src\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "# Load file môi trường\n",
    "load_dotenv(dotenv_path=\"../.env\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.api_client import get_all_btc_options, get_order_book"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"🔄 Bước 1: Đang quét danh sách hợp đồng quyền chọn BTC từ Deribit...\")\n",
    "raw_instruments = get_all_btc_options()\n",
    "print(f\"📊 Tìm thấy {len(raw_instruments)} hợp đồng đang hoạt động.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chọn một số lượng hợp đồng nhất định để chạy thử (Ví dụ: 30 hợp đồng đầu tiên)\n",
    "# Để quét toàn bộ sàn, hãy bỏ giới hạn [:30]\n",
    "sampled_instruments = raw_instruments[:30] \n",
    "\n",
    "all_data = []\n",
    "print(\"\\n🔄 Bước 2: Đang quét sổ lệnh và bóc tách giá thị trường thời gian thực...\")\n",
    "\n",
    "for idx, inst in enumerate(sampled_instruments):\n",
    "    name = inst['instrument_name']\n",
    "    strike = inst['strike']\n",
    "    opt_type = inst['option_type']\n",
    "    exp_timestamp = inst['expiration_timestamp']\n",
    "    \n",
    "    # Gọi hàm lấy giá sổ lệnh\n",
    "    market_prices = get_order_book(name)\n",
    "    \n",
    "    if market_prices:\n",
    "        # Chỉ lấy khi cả hai bên mua và bán đều có người đặt lệnh (Thanh khoản thực)\n",
    "        if market_prices[\"best_bid_price\"] > 0 and market_prices[\"best_ask_price\"] > 0:\n",
    "            # Tính giá trung bình thị trường (Mid Price) để làm giá quyền chọn thực tế (V)\n",
    "            mid_price = (market_prices[\"best_bid_price\"] + market_prices[\"best_ask_price\"]) / 2\n",
    "            \n",
    "            row = {\n",
    "                \"instrument_name\": name,\n",
    "                \"strike_K\": strike,\n",
    "                \"option_type\": opt_type,\n",
    "                \"expiration_timestamp\": exp_timestamp,\n",
    "                \"underlying_price_S\": market_prices[\"underlying_price\"],\n",
    "                \"option_price_V\": mid_price,\n",
    "                \"best_bid\": market_prices[\"best_bid_price\"],\n",
    "                \"best_ask\": market_prices[\"best_ask_price\"]\n",
    "            }\n",
    "            all_data.append(row)\n",
    "            \n",
    "    # Nghỉ 0.05 giây để tránh dính lỗi Rate Limit (20 requests/sec) của sàn\n",
    "    time.sleep(0.05)\n",
    "    \n",
    "    if (idx + 1) % 10 == 0:\n",
    "        print(f\"   ✅ Đã xử lý xong {idx + 1}/{len(sampled_instruments)} hợp đồng...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==========================================\n",
    "# BƯỚC 4: CHUYỂN THÀNH DATAFRAME VÀ XUẤT FILE\n",
    "# ==========================================\n",
    "if all_data:\n",
    "    df_final = pd.DataFrame(all_data)\n",
    "    \n",
    "    # Đổi định dạng ngày đáo hạn sang YYYY-MM-DD\n",
    "    df_final['expiration_date'] = df_final['expiration_timestamp'].apply(\n",
    "        lambda x: datetime.fromtimestamp(x / 1000).strftime('%Y-%m-%d')\n",
    "    )\n",
    "    \n",
    "    # Tính thời gian đáo hạn T (đơn vị: Năm) - Giả định lãi suất phi rủi ro r = 4.5% (0.045)\n",
    "    # T = (Tổng số giây đến đáo hạn) / (365 * 24 * 3600)\n",
    "    today = datetime.now()\n",
    "    df_final['time_to_maturity_T'] = df_final['expiration_timestamp'].apply(\n",
    "        lambda x: max((datetime.fromtimestamp(x / 1000) - today).total_seconds() / (365.0 * 86400.0), 0.001)\n",
    "    )\n",
    "    df_final['risk_free_rate_r'] = 0.045 # Hằng số lãi suất giả định của thị trường\n",
    "    \n",
    "    # Sắp xếp lại các cột cho đẹp mắt theo chuẩn cấu hình toán học Heston\n",
    "    final_columns = [\n",
    "        'instrument_name', 'option_type', 'underlying_price_S', \n",
    "        'strike_K', 'time_to_maturity_T', 'risk_free_rate_r', 'option_price_V'\n",
    ] \n",
    "    df_final = df_final[final_columns]\n",
    "    \n",
    "    # Lưu file thô vào thư mục data/raw/\n",
    "    os.makedirs(\"../data/raw\", exist_ok=True)\n",
    "    df_final.to_csv(\"../data/raw/btc_options_raw.csv\", index=False)\n",
    "    \n",
    "    print(\"\\n🎉 GIAI ĐOẠN 1 HOÀN THÀNH XUẤT SẮC!\")\n",
    "    print(f\"File dữ liệu 'btc_options_raw.csv' đã được lưu tại thư mục 'data/raw/'. Tổng số dòng sạch: {len(df_final)}\")\n",
    "    print(df_final.head())\n",
    "else:\n",
    "    print(\"\\n❌ Không lấy được dữ liệu thị trường. Vui lòng kiểm tra lại kết nối mạng hoặc API Key!\")"
   ]
  }
 ],
